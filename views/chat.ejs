<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Campusfify Chat</title>

  <!-- Google Fonts – only Inter (clean, readable) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 icons (for header buttons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Local Tailwind CSS -->
  <link rel="stylesheet" href="/css/tailwind.css">

  <!-- Tiny custom CSS – only animations & scrollbar that Tailwind can’t handle -->
  <link rel="stylesheet" href="/css/tiny-chat.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
        }
      }
    }
  </script>
</head>
<body class="font-sans bg-[#f5f7fb] text-[#1a1a2e] h-full max-h-screen flex flex-col overflow-hidden">

  <!-- HEADER -->
  <header class="bg-white/90 backdrop-blur-md flex items-center justify-between px-4 py-2 gap-2 border-b border-black/5 min-h-[60px] z-10 flex-nowrap">
    <div class="flex items-center gap-3 flex-1 min-w-0">
      <a href="/" class="text-gray-500 hover:text-gray-900 p-2 rounded-full transition text-xl">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-semibold uppercase bg-gradient-to-br from-pink-500 to-pink-700 shadow-lg shadow-pink-500/20">
        <% if (user.id === 1) { %>R<% } else { %>M<% } %>
      </div>
      <div class="min-w-0 flex-1">
        <div class="text-[17px] font-semibold truncate tracking-tight">
          <% if (user.id === 1) { %>Chat with Manu<% } else { %>Chat with Rasuv<% } %>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <button id="refreshChatBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-medium bg-blue-50 text-blue-600 hover:bg-blue-100 transition min-h-[44px]">
        <i class="fas fa-sync-alt"></i> <span class="hidden sm:inline">Refresh</span>
      </button>

      <% if (user.id === 1) { %>
        <button id="dashboardToggle" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 transition min-h-[44px]">
          <i class="fas fa-chart-bar"></i> <span class="hidden sm:inline">Dashboard</span>
        </button>
        <button id="clearChatBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition min-h-[44px]">
          <i class="fas fa-trash-alt"></i> <span class="hidden sm:inline">Clear</span>
        </button>
      <% } %>
      <a href="/logout" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-medium bg-red-50 text-red-600 hover:bg-red-100 transition min-h-[44px] no-underline">
        <i class="fas fa-sign-out-alt"></i> <span class="hidden sm:inline">Logout</span>
      </a>
    </div>
  </header>

  <!-- MESSAGES CONTAINER (relative for popover positioning) -->
  <div id="messagesContainer" class="flex-1 overflow-y-auto p-4 pb-2 bg-[#f0f2f8] flex flex-col gap-[1px] relative">

    <!-- ACTION POPOVER (hidden, positioned by JS) – moved inside container so event delegation works -->
    <div id="actionPopover" class="hidden fixed bg-white rounded-2xl shadow-lg p-2 flex gap-1 z-[1000] border border-gray-100">
      <button class="popover-like-btn px-3 py-2 rounded-xl text-sm font-medium bg-gray-50 text-gray-700 hover:bg-pink-50 hover:text-pink-600 transition">❤️ Like</button>
      <button class="popover-reply-btn px-3 py-2 rounded-xl text-sm font-medium bg-gray-50 text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition">↩ Reply</button>
      <button class="popover-edit-btn px-3 py-2 rounded-xl text-sm font-medium bg-gray-50 text-gray-700 hover:bg-yellow-50 hover:text-yellow-600 transition">✏️ Edit</button>
      <button class="popover-delete-btn px-3 py-2 rounded-xl text-sm font-medium bg-gray-50 text-gray-700 hover:bg-red-50 hover:text-red-600 transition">🗑 Delete</button>
    </div>

    <!-- dynamically filled by JS -->
  </div>

  <!-- NEW MESSAGES FLOATING BUTTON (count only) -->
  <button id="newMessagesBtn" class="fixed bottom-24 right-5 bg-green-500 text-white rounded-full px-5 py-2.5 text-sm font-semibold shadow-lg shadow-green-500/20 z-50 hidden items-center gap-2 hover:scale-105 active:scale-95 transition-transform animate-bounceIn">
    ↓ <span id="newMsgCount">0</span>
  </button>

  <!-- TYPING INDICATOR -->
  <div id="typingIndicator" class="hidden items-center gap-2 px-4 py-1.5 shrink-0">
    <div class="flex gap-1">
      <span class="w-2 h-2 rounded-full bg-pink-500 animate-bounce"></span>
      <span class="w-2 h-2 rounded-full bg-pink-500 animate-bounce [animation-delay:0.2s]"></span>
      <span class="w-2 h-2 rounded-full bg-pink-500 animate-bounce [animation-delay:0.4s]"></span>
    </div>
    <span id="typingText" class="text-sm text-gray-500">manu is typing…</span>
  </div>

  <!-- REPLY PREVIEW -->
  <div id="replyPreview" class="hidden items-center gap-3 px-4 py-2 bg-white/80 backdrop-blur border-t border-black/5 shrink-0">
    <div id="replyText" class="flex-1 text-sm text-gray-500 py-1.5 px-3 bg-gray-50 rounded-xl border-l-2 border-pink-500 truncate"></div>
    <button id="cancelReply" class="text-gray-500 hover:text-red-500 p-1 rounded-full transition hover:rotate-90 text-xl">×</button>
  </div>

  <!-- INPUT AREA -->
  <form id="messageForm" class="flex gap-2 px-4 py-2.5 pb-3.5 bg-white border-t border-black/5 shrink-0 items-center">
    <div class="flex-1 flex items-center bg-gray-100 rounded-full pl-3 pr-1 border border-transparent focus-within:bg-white focus-within:border-pink-500 focus-within:shadow-[0_0_0_3px_rgba(233,30,99,0.06)] transition">
      <button type="button" id="emojiBtn" class="text-gray-500 hover:text-pink-500 p-1 transition">😊</button>
      <textarea id="messageInput" placeholder="Type a message..." rows="1" class="flex-1 px-1 py-2 border-0 bg-transparent resize-none text-base leading-relaxed max-h-28 outline-none font-sans"></textarea>
    </div>
    <button type="submit" id="sendBtn" class="px-5 py-2 rounded-full bg-gradient-to-r from-pink-500 to-pink-700 text-white font-semibold shadow-md shadow-pink-500/20 hover:scale-105 active:scale-95 transition disabled:opacity-40 disabled:pointer-events-none">Send</button>
  </form>

  <!-- DASHBOARD MODAL (rasuv only) -->
  <% if (user.id === 1) { %>
    <div id="dashboardModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm hidden justify-center items-center z-[10000]" onclick="if(event.target===this) this.classList.add('hidden')">
      <div class="bg-white rounded-3xl p-8 w-[90%] max-w-lg max-h-[85vh] overflow-y-auto shadow-2xl relative animate-dashSlideIn">
        <span id="closeDashboard" class="absolute top-4 right-5 text-2xl text-gray-400 hover:text-pink-500 hover:rotate-90 transition cursor-pointer">&times;</span>
        <h2 class="text-2xl font-semibold mb-6">Admin Dashboard</h2>
        <div id="dashboardData">Loading...</div>
      </div>
    </div>
  <% } %>

  <!-- Viewport height fix for mobile -->
  <script>
    function setViewportHeight() {
      document.body.style.height = window.innerHeight + 'px';
    }
    window.addEventListener('resize', setViewportHeight);
    window.addEventListener('orientationchange', setViewportHeight);
    setViewportHeight();
  </script>

  <script>
    window.USER = <%- JSON.stringify(user) %>;
  </script>
  <script src="/js/chat.js"></script>
  <% if (user.id === 1) { %>
    <script src="/js/dashboard.js"></script>
  <% } %>
</body>
</html>